{
  "name": "lab-report-wizard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "实验报告向导 —— 按模板顺序填写，截图/粘贴，一键导出 Word",
  "scripts": {
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/serve.ps1",
    "stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop.ps1",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "verify:export": "esbuild scripts/verify-export.ts --bundle --platform=node --format=esm --outfile=scripts/out/verify.mjs --log-level=warning && node scripts/out/verify.mjs",
    "verify:render": "esbuild scripts/verify-render.tsx --bundle --platform=node --format=esm --loader:.css=empty --external:react --external:react-dom --external:react-dom/server --outfile=scripts/out/render.mjs --log-level=warning && node scripts/out/render.mjs",
    "verify:storage": "esbuild scripts/verify-storage.ts --bundle --platform=node --format=esm --outfile=scripts/out/storage.mjs --log-level=warning && node scripts/out/storage.mjs",
    "verify:headings": "esbuild scripts/verify-headings.tsx --bundle --platform=node --format=esm --loader:.css=empty --external:react --external:react-dom --external:react-dom/server --outfile=scripts/out/headings.mjs --log-level=warning && node scripts/out/headings.mjs",
    "verify:import": "esbuild scripts/verify-import.ts --bundle --platform=node --format=esm --outfile=scripts/out/import.mjs --log-level=warning && node scripts/out/import.mjs",
    "verify": "npm run verify:storage && npm run verify:export && npm run verify:render && npm run verify:headings && npm run verify:import"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@xmldom/xmldom": "^0.9.12",
    "esbuild": "^0.21.5",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
